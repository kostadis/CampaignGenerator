#!/bin/bash
# Production startup — builds the Vue frontend and serves everything via FastAPI.
# Usage: ./startup [--campaign-dir /path/to/campaign] [--session-dir /path/to/session] [--port 5000]
#
# Open http://localhost:5000 in your browser.

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Build frontend if dist is missing or ANY source/config file is newer than the
# built bundle. NOTE: do not test `frontend/src -nt dist/index.html` — that
# compares the src *directory* mtime, which Linux does not bump when you edit an
# existing file inside it (only add/remove/rename touches a dir's mtime). That
# heuristic silently skips rebuilds after content edits and serves a stale
# bundle. Scan files recursively with `find -newer` instead.
FE="$SCRIPT_DIR/frontend"
DIST="$FE/dist"
if [ ! -f "$DIST/index.html" ] || \
   [ -n "$(find "$FE/src" "$FE/index.html" "$FE/vite.config.ts" "$FE/package.json" \
              -type f -newer "$DIST/index.html" 2>/dev/null | head -n 1)" ]; then
  echo "Building frontend..."
  ( cd "$FE" && npm run build )
fi

# Parse --port from args for the startup message
PORT=5000
PREV=""
for ARG in "$@"; do
    if [ "$PREV" = "--port" ]; then PORT="$ARG"; fi
    PREV="$ARG"
done

# Launch FastAPI (serves the Vue build as static files)
# PYTHONPATH lets `python -m server.main` find the server package
# while keeping CWD as the campaign directory (the server falls back to
# CWD/config.yaml when no --campaign-dir is passed)
echo "Starting Campaign Generator on http://localhost:$PORT"
export PYTHONPATH="$SCRIPT_DIR${PYTHONPATH:+:$PYTHONPATH}"
exec python -m server.main "$@"
