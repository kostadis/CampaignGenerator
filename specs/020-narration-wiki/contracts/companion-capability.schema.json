{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campaigngenerator.local/schemas/narration-wiki-companion-capability-v1.json",
  "title": "Narration Wiki Companion Capability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_repository",
    "source_revision",
    "narration_wiki_contract",
    "guidance_source",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_repository": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "narration_wiki_contract": {
      "const": 1
    },
    "guidance_source": {
      "const": "campaign-resolved"
    },
    "capabilities": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "maintainer",
          "proposer"
        ]
      },
      "allOf": [
        {
          "contains": {
            "const": "maintainer"
          }
        },
        {
          "contains": {
            "const": "proposer"
          }
        }
      ]
    }
  }
}
